                      00001 ;====================================================
                      00002 ; PIC16F877A ADC Example
                      00003 ; Read AN0 and display upper 8 bits on PORTC, and 7-segment on PORTB and PORTD
                      00004 ; Clock: 20 MHz Crystal
                      00005 ; Pin mapping:
                      00006 ; RA0   -> Analog input
                      00007 ; RA1-5 -> unused
                      00008 ; RB0   -> External interrupt
                      00009 ; RB1-7 -> 7-segments, segment a-g
                      00010 ; RC0-7 -> unused
                      00011 ; RD0-3 -> 7-segments, shared by D3-D0
                      00012 ; RD4-7 -> Reserved for keypad input
                      00013 ;====================================================
                      00014 
